# =============================================================================
# SIH Predictive Infrastructure Monitoring — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# Do NOT commit .env to version control.

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_password
POSTGRES_DB=sih_monitor
# These values are for native local development. Docker Compose derives its
# internal API connection string from the same user, password, and database.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port exposed by Docker Compose; 5433 avoids conflicts with local PostgreSQL.
POSTGRES_HOST_PORT=5433

# Required only when running setup_db.py to initialise a native local instance.
# Use an existing PostgreSQL administrator account; do not commit real credentials.
POSTGRES_ADMIN_URL=postgresql://postgres@localhost:5432/postgres

# Async connection string for native local FastAPI and Alembic commands.
DATABASE_URL=postgresql+asyncpg://sih_user:sih_password@localhost:5432/sih_monitor

# -----------------------------------------------------------------------------
# FastAPI
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
CORS_ORIGINS=["http://localhost:3000"]

# -----------------------------------------------------------------------------
# Next.js Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
